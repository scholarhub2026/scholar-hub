# ---------------------------------------------------------------------------
# Scholar Hub backend — environment template (safe to commit; no secrets).
# Local dev:  cp .env.example .env  and fill in your DEV values.
# Production: set these same keys as host (e.g. Railway) variables.
# Every key below is actually read by the code — nothing extra.
# ---------------------------------------------------------------------------

NODE_ENV=development          # development | production
PORT=5000

# Public URL of the FRONTEND, used in email links (login button) + logo.
#   dev host  -> https://scholar-hub-smoky.vercel.app
#   prod host -> https://www.scholarhub.live
FRONTEND_URL=http://localhost:8080

# Browser origins allowed to call this API (comma-separated, no trailing slash).
#   dev host  -> https://<your-dev-frontend-url>
#   prod host -> https://www.scholarhub.live
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Database — use a DIFFERENT db per environment --------------------------
#   dev  -> mongodb+srv://<devUser>:<pass>@<devCluster>/scholarhub_dev?retryWrites=true&w=majority
#   prod -> mongodb+srv://<prodUser>:<pass>@<prodCluster>/scholarhub_prod?...
DATABASE_URL=

# --- Auth (JWT) — generate with: openssl rand -hex 32 -----------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
AUTH_ENFORCED=false           # true = enforce role guards (do this once every client sends the token)

# --- Referral reward amounts ------------------------------------------------
REFERRAL_REWARD=100
REFERRAL_WELCOME=50

# --- Media (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=

# --- Email — set MAIL_FROM (a verified sender) + ONE provider below ----------
# On hosts that block SMTP (Railway, Render), use an HTTP-API provider:
#   Brevo (free 300/day, recommended) -> set BREVO_API_KEY
#   SendGrid                          -> set SENDGRID_API_KEY
# Plain SMTP (MAIL_HOST/USER/PASS) only works where outbound SMTP is allowed.
MAIL_FROM=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# --- Push (OPTIONAL; empty = disabled) --------------------------------------
FIREBASE_SERVICE_ACCOUNT=
# or: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
