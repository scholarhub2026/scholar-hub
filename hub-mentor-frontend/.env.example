# Scholar Hub web — environment template (safe to commit; no secrets).
# Local dev: cp .env.example .env

# Backend API base URL, including the /api suffix.
#   dev  -> http://localhost:5000/api
#   prod -> https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay PUBLIC key id (the key_id; safe to expose in the browser).
VITE_RAZORPAY_KEY_ID=
